{
  "name": "@private-signal-swarm/cre-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/workflow.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "generate:payload": "node --loader ts-node/esm scripts/generate-simulate-payload.ts",
    "simulate": "node --loader ts-node/esm scripts/run-simulate.ts",
    "simulate:plain": "SIMULATE_TARGET=plain-settings node --loader ts-node/esm scripts/run-simulate.ts"
  },
  "dependencies": {
    "@chainlink/cre-sdk": "^1.20.1",
    "@chainlink/cre-sdk-javy-plugin": "1.7.0",
    "@private-signal-swarm/confidential-core": "workspace:*",
    "@private-signal-swarm/types": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
