# CRE Simulation Environment Variables

# Ethereum private key for chain write simulation (optional)
# If not provided, a random key will be generated for simulation
CRE_ETH_PRIVATE_KEY=

# TEE secrets with distinct env var names (recommended by CRE)
# These must match the values in packages/confidential-core/.dev-keys/dev-secrets.json
CRE_TEE_ENC_PUB=
CRE_TEE_ENC_PRIV=
CRE_TEE_SIGN_PRIV=

SECRET_COORDINATOR_AUTH_KEY=
