# Resource Server
PORT=3000
NODE_ENV=development

# x402 Payment Configuration (optional for dev)
# v2 stack: @x402/express + @x402/hedera, settled via Blocky402 facilitator.
# For a live Hedera leg set X402_PAY_TO to a 0.0.x account and fund a payer:
#   HEDERA_ACCOUNT_ID / HEDERA_PRIVATE_KEY (ECDSA testnet account, see scripts/pay-for-verdict.ts)
X402_PAY_TO=
X402_NETWORK=hedera:testnet
X402_PRICE=$0.01
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_NETWORK=hedera:testnet

# Coordinator
COORDINATOR_PORT=3001
QUORUM=3
KEYMAP_PATH=packages/confidential-core/.dev-keys/keymap.json
DEV_SECRETS_PATH=packages/confidential-core/.dev-keys/dev-secrets.json
STATE_DIR=./state
RESULT_INGEST_URL=http://localhost:3000/api/internal/ingest

# Agent
AGENT_ID=agent-1
COORDINATOR_ENDPOINT=http://localhost:3001

# Agent reasoning (how agents deliberate)
# AGENT_REASONING=mock           # default: deterministic mock ballots, no network, no key
# AGENT_REASONING=llm            # real LLM deliberation — REQUIRES LLM_API_KEY below
#
# LLM provider presets (OpenAI-compatible; pick ONE set, export all three together —
# a key aimed at the wrong base URL fails auth, and vice versa):
#
# NVIDIA (no card, free key at build.nvidia.com):
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-...
# LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
#
# Google Gemini (free key at aistudio.google.com):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-3.6-flash
#
# Optionals (sane defaults, touch only with reason):
# LLM_TIMEOUT_MS=90000           # per-attempt abort; free-tier queues need room
AGENT_REASONING=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=

# Deployed CRE trigger (optional — arms automatically when all four are set)
# Each Deliberate quorum is then also fired at the deployed DON workflow;
# the verdict is still served instantly from the local seam.
CRE_GATEWAY_URL=https://01.gateway.zone-a.cre.chain.link/
CRE_WORKFLOW_ID=0066a0bde3480237aae16e638a6a15dfae737fc2ea85418116287587079c3aed
COORDINATOR_SIGNING_KEY=
DON_TEE_ENC_PUB=
DON_TEE_SIGN_PUB=

# CRE / DON secrets (single source of truth — consumed via cre/secrets.yaml
# as TEE_ENC_PUB/PRIV + TEE_SIGN_PRIV, and as trigger auth for the DON).
# TEE values must match packages/confidential-core/.dev-keys/dev-secrets.json.
# Generate with: pnpm --filter @private-signal-swarm/confidential-core keygen
CRE_ETH_PRIVATE_KEY=
CRE_TEE_ENC_PUB=
CRE_TEE_ENC_PRIV=
CRE_TEE_SIGN_PRIV=
SECRET_COORDINATOR_AUTH_KEY=
TRIGGER_PRIVATE_KEY=
