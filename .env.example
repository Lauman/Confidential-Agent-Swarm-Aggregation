# Resource Server
PORT=3000
NODE_ENV=development

# x402 Payment Configuration (optional for dev)
X402_PAY_TO=
X402_NETWORK=base-sepolia
X402_PRICE=$0.01
X402_FACILITATOR_URL=

# Coordinator
COORDINATOR_PORT=3001
QUORUM=3
KEYMAP_PATH=packages/confidential-core/.dev-keys/keymap.json
DEV_SECRETS_PATH=packages/confidential-core/.dev-keys/dev-secrets.json
STATE_DIR=./state
RESULT_INGEST_URL=http://localhost:3000/api/internal/ingest

# Agent
AGENT_ID=agent-1
COORDINATOR_ENDPOINT=http://localhost:3001
